# 🔐 Django secret key (escape # with \ if needed)
SECRET_KEY=__REQUIRED__ # Unique key to protect the application

# 🐘 PostgreSQL
POSTGRES_DB=__REQUIRED__ # Database name
POSTGRES_USER=__REQUIRED__
POSTGRES_PASSWORD=__REQUIRED__
DB_HOST=db
DB_PORT=5432

# 📦 Docker-specific
PG_DATA=/var/lib/postgresql/data
POSTGRES_PORT_HOST=5433

# 📁 Static files
STATIC=/home/docker_user/app/staticfiles

# 🧠 Python runtime
PYTHONUNBUFFERED=1
DJANGO_SETTINGS_MODULE=djangogramm.settings
